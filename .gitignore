# Scratch commit message, written when the sandbox could not commit directly.
.commitmsg

# Cross-client evidence: 30+ PNGs per run, regenerated on demand and uploaded
# by CI as a build artifact. report.json is small and reviewable, so it stays.
validation/crossclient/*.png
# Recursive too: a page name containing a slash once wrote a PNG into a
# subdirectory, where the pattern above did not reach it.
validation/crossclient/**/*.png

# Render evidence: was 7 PNGs, became 77 the day there were ten styles, and
# every run rewrites all of them. CI uploads the set as a build artifact,
# which is where you actually look at them. report.json stays - it is small,
# reviewable, and diffs usefully.
validation/screenshots/*.png

build/vendor/node_modules/
build/vendor/package-lock.json
build/vendor/package.json
__pycache__/
.DS_Store

# Scratch harness written by hand when debugging layout in a real browser.
_narrow.html
